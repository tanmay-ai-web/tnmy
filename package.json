{
  "name": "tnmy",
  "version": "2.4.0",
  "description": "High-performance modular developer toolkit & microservice foundation",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "jest --coverage",
    "test:stress": "node scripts/stress.js",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts"
  },
  "keywords": [
    "typescript",
    "microservices",
    "cache",
    "events",
    "toolkit",
    "redis",
    "auth"
  ],
  "author": "TANMAY JAIN <216941028+tanmay-ai-web@users.noreply.github.com>",
  "license": "MIT",
  "dependencies": {
    "ioredis": "^5.4.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.9",
    "jest": "^29.7.0",
    "typescript": "^5.5.3"
  }
}

